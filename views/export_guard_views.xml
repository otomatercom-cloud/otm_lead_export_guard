<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_export_access_list" model="ir.ui.view">
        <field name="name">res.users.export.access.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="login" readonly="1"/>
                <field name="otm_can_export_leads" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_users_export_access_search" model="ir.ui.view">
        <field name="name">res.users.export.access.search</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="login"/>
                <filter name="can_export" string="Can export" domain="[('otm_can_export_leads', '=', True)]"/>
                <filter name="cannot_export" string="Blocked" domain="[('otm_can_export_leads', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_lead_export_access" model="ir.actions.act_window">
        <field name="name">Lead Export Access</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="domain">[('share', '=', False)]</field>
        <field name="view_id" ref="view_users_export_access_list"/>
        <field name="search_view_id" ref="view_users_export_access_search"/>
    </record>

    <record id="view_lead_export_log_list" model="ir.ui.view">
        <field name="name">otm.lead.export.log.list</field>
        <field name="model">otm.lead.export.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="result == 'blocked'">
                <field name="date"/>
                <field name="user_id"/>
                <field name="result"/>
                <field name="record_count"/>
                <field name="field_count"/>
                <field name="note"/>
                <field name="model"/>
            </list>
        </field>
    </record>
    <record id="view_lead_export_log_search" model="ir.ui.view">
        <field name="name">otm.lead.export.log.search</field>
        <field name="model">otm.lead.export.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <filter name="blocked" string="Blocked" domain="[('result', '=', 'blocked')]"/>
                <filter name="allowed" string="Exported" domain="[('result', '=', 'allowed')]"/>
                <group>
                    <filter name="by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="by_result" string="Result" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_lead_export_log" model="ir.actions.act_window">
        <field name="name">Lead Export Log</field>
        <field name="res_model">otm.lead.export.log</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Approvers -->
    <record id="view_export_approver_list" model="ir.ui.view">
        <field name="name">otm.lead.export.approver.list</field>
        <field name="model">otm.lead.export.approver</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="user_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_export_approver" model="ir.actions.act_window">
        <field name="name">Approvers (Directors)</field>
        <field name="res_model">otm.lead.export.approver</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Requests -->
    <record id="view_export_request_list" model="ir.ui.view">
        <field name="name">otm.lead.export.request.list</field>
        <field name="model">otm.lead.export.request</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-success="state == 'approved'" decoration-danger="state == 'locked'" decoration-muted="state == 'expired'">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="reason"/>
                <field name="minutes"/>
                <field name="state"/>
                <field name="unlocked_until"/>
                <field name="revealed_by" optional="hide"/>
                <button name="action_open_unlock" type="object" string="Enter Code" invisible="state != 'sent'"/>
            </list>
        </field>
    </record>
    <record id="action_export_request" model="ir.actions.act_window">
        <field name="name">Export Requests</field>
        <field name="res_model">otm.lead.export.request</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_export_approval_list" model="ir.ui.view">
        <field name="name">otm.lead.export.approval.list</field>
        <field name="model">otm.lead.export.request</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="reason"/>
                <field name="minutes"/>
                <field name="code_expiry"/>
                <button name="action_show_code" type="object" string="Show code" class="btn-primary"/>
            </list>
        </field>
    </record>
    <record id="action_export_approvals" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">otm.lead.export.request</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_export_approval_list"/>
        <field name="domain">[('state', '=', 'sent'), ('user_id', '!=', uid)]</field>
    </record>

    <record id="view_export_setting_form" model="ir.ui.view">
        <field name="name">otm.lead.export.setting.form</field>
        <field name="model">otm.lead.export.setting</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group string="Approval code mail">
                        <field name="mail_enabled"/>
                        <field name="mail_server_id" invisible="not mail_enabled" options="{'no_create': True}"/>
                    </group>
                    <p class="text-muted">The code always shows under Lead Export &gt; Approvals. Mail goes to the Odoo user email of each approver, never to the requester. The mail record is deleted right after sending.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_export_setting" model="ir.actions.act_window">
        <field name="name">Export Settings</field>
        <field name="res_model">otm.lead.export.setting</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="setting_default"/>
    </record>

    <!-- Wizards -->
    <record id="view_export_request_wizard_form" model="ir.ui.view">
        <field name="name">otm.lead.export.request.wizard.form</field>
        <field name="model">otm.lead.export.request.wizard</field>
        <field name="arch" type="xml">
            <form>
                <p class="text-muted">Your Director will get a one-time code (in Odoo and by email). Ask them for it, then enter it on the next screen.</p>
                <group>
                    <field name="reason" placeholder="Why do you need this export?"/>
                    <field name="minutes"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send code to Director" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_export_request_wizard" model="ir.actions.act_window">
        <field name="name">Request Export</field>
        <field name="res_model">otm.lead.export.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_export_unlock_wizard_form" model="ir.ui.view">
        <field name="name">otm.lead.export.unlock.wizard.form</field>
        <field name="model">otm.lead.export.unlock.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="request_id" invisible="1"/>
                <p class="text-muted">Enter the 6-digit code the Director gave you. The code is valid for 10 minutes and works once.</p>
                <group>
                    <field name="code" placeholder="123456" autocomplete="off"/>
                </group>
                <footer>
                    <button name="action_unlock" type="object" string="Unlock export" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_lead_export_root" name="Lead Export"
              groups="base.group_system,otm_lead_export_guard.group_lead_export,otm_lead_export_guard.group_export_approver" sequence="95"/>
    <menuitem id="menu_lead_export_request" name="Request Export" parent="menu_lead_export_root"
              action="action_export_request_wizard" groups="otm_lead_export_guard.group_lead_export" sequence="1"/>
    <menuitem id="menu_lead_export_approvals" name="Approvals" parent="menu_lead_export_root"
              action="action_export_approvals" groups="otm_lead_export_guard.group_export_approver" sequence="2"/>
    <menuitem id="menu_lead_export_requests" name="Export Requests" parent="menu_lead_export_root"
              action="action_export_request" sequence="3"/>
    <menuitem id="menu_lead_export_access" name="Export Access" parent="menu_lead_export_root"
              action="action_lead_export_access" groups="base.group_system" sequence="3"/>
    <menuitem id="menu_lead_export_approvers" name="Approvers" parent="menu_lead_export_root"
              action="action_export_approver" groups="base.group_system" sequence="4"/>
    <menuitem id="menu_lead_export_setting" name="Settings" parent="menu_lead_export_root"
              action="action_export_setting" groups="base.group_system" sequence="6"/>
    <menuitem id="menu_lead_export_log" name="Export Log" parent="menu_lead_export_root"
              action="action_lead_export_log" groups="base.group_system" sequence="5"/>
</odoo>
